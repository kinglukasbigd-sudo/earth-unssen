# =========================================================
# Earth Unseen — environment configuration
# Copy to .env.local and adjust as needed.
# =========================================================

# ---- Backend mode ---------------------------------------------------------
# "auto"   → use Supabase when SUPABASE_URL + SUPABASE_ANON_KEY are set,
#            otherwise fall back to the local development backend.
# "local"  → force the local backend (no Supabase account required).
# "supabase" → force Supabase (errors if keys are missing).
DATA_BACKEND=local

# ---- Local backend (only used when DATA_BACKEND is "local") ---------------
# Password for the single admin account (default: earth-unseen).
# Change it here, or later from the studio's Account window — a password
# set there is stored hashed in data/auth.json and takes precedence.
ADMIN_PASSWORD=earth-unseen

# Secret used to sign the admin session cookie. Leave empty to have one
# generated and stored in data/auth.json, or set a long random string
# (e.g. the output of `openssl rand -base64 32`).
SESSION_SECRET=

# ---- Supabase (production backend) ----------------------------------------
# Create a project at https://supabase.com, run the migration in
# supabase/migrations/0001_init.sql, create an admin user, then set:
# SUPABASE_URL=https://YOURREF.supabase.co
# SUPABASE_ANON_KEY=your-publishable-anon-key
# ADMIN_EMAIL=you@example.com

# Public site URL (used for sitemap / canonical / og URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
